{
  "name": "dsh-terminal-theme",
  "version": "0.2.3",
  "description": "Reversible terminal-style theme for DeepSeek Harness. Native Markdown, KaTeX and Shiki stay in place.",
  "type": "commonjs",
  "license": "MIT",
  "engines": { "dsh": "0.2.1-rc.2" },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-theme"] }
  },
  "files": ["lib/index.js", "lib/client.js", "cordis.patch.yml", "LICENSE", "vendor/package/LICENSE"],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/theme.test.mjs"
  }
}
